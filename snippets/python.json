  "context(class template)  snippet.iWonder": {
    "prefix": "context-manager",
    "body": "class ${1:ContextManager}(object):\n    def __init__(self, ${2:key}=None):\n        self.${2:key} = ${2:key}\n        self.handle = None\n\n    def __enter__(self):\n        self.handle = ${3:None}\n        return self.handle\n\n    def __exit__(self, exc_type, exc_value, traceback):\n        if self.handle:\n            self.handle.close()\n\n        if exc_type:\n            return False  # False: the exception will be re-raised.\n\n\n",
    "description": "Create a custom context manager class."
  },
